<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <RootNamespace>SB.Framework.Models</RootNamespace>
    <AssemblyName>SB.Framework.Models</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId Condition="'$(DisableLicense)' != 'true'">SB.Framework.Models</PackageId>
    <PackageId Condition="'$(DisableLicense)' == 'true'">SB.Framework.Models.NoLicense</PackageId>
    <Version>0.1.0-preview.21</Version>
    <Description>SB Framework 基础领域模型</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FreeSql" Version="3.5.109" />
  </ItemGroup>

</Project>
