<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!--
      源优先级（2026-10-08 按用户要求配置）：

      ① internal：内网 BaGet（192.168.2.110:8082）**优先**
         · 已配 Mirror：nuget.org 的公共包可透传，并缓存在内网
         · 内网访问比公网快，nuget.org 抖动时不受影响
         · 实测：清缓存后拉一个从未下载过的包（Polly）成功，Mirror 生效
         · ⚠️ 必须 allowInsecureConnections="true"：它是 **HTTP**（非 HTTPS），
           不加会被 NuGet 拒绝（NU1301「仅允许 HTTPS 源」）

      ② nuget.org：次选
         · 兜底：内网源未缓存且透传失败时仍能构建
         · 也是公网发布的推送目标（见 scripts/pack-push.sh）

      ⚠️ 已移除的源：https://nuget.saibo.club（Cloudflare 404，子域未配置）
         与 http://192.168.10.68（不可达）。两者均于 2026-10-08 确认失效。
    -->
    <add key="internal" value="http://192.168.2.110:8082/v3/index.json" allowInsecureConnections="true" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
