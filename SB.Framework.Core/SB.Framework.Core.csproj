<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SB.Framework.Core</RootNamespace>
    <AssemblyName>SB.Framework.Core</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId Condition="'$(DisableLicense)' != 'true'">SB.Framework.Core</PackageId>
    <PackageId Condition="'$(DisableLicense)' == 'true'">SB.Framework.Core.NoLicense</PackageId>
    <Version>0.4.2</Version>
    <Authors>Sb Framework</Authors>
    <Description>SB Framework 基础工具与原语</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 开发期：框架内部包走 ProjectReference，一次编译全贯通，无需链式发包。
         发布期：dotnet pack 自动把 ProjectReference 转成对应版本的包依赖；
         变体（正常 / NoLicense）由 dotnet pack 的 -p:DisableLicense 参数统一控制，不在此写死。 -->
    <ProjectReference Include="..\SB.Framework.Models\SB.Framework.Models.csproj" />
    <ProjectReference Include="..\SB.Framework.Analyzers\SB.Framework.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="FreeSql.Repository" Version="3.5.304" />
    <!-- Feature 发现层：读 .deps.json 的 RuntimeLibraries 枚举程序集 -->
    <PackageReference Include="Microsoft.Extensions.DependencyModel" Version="9.0.3" />
    <!-- Feature 启动日志 + 装配上下文 Logger -->
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.3.0" />
    <PackageReference Include="SixLabors.Fonts" Version="2.0.8" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.5" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.3.0" />
  </ItemGroup>

</Project>
