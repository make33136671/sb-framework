<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <RootNamespace>SB.Framework.Services</RootNamespace>
    <AssemblyName>SB.Framework.Services</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.5.2</Version>
    <Description>SB Framework 基础应用服务 + 扩展点</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FreeSql.Repository" Version="3.5.304" />
    <PackageReference Include="GoogleAuthenticator" Version="3.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="9.0.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.3" />
    <!-- 通用电子表格读取(xlsx/xls/csv)→ ISpreadsheetReader / NpoiSpreadsheetReader -->
    <PackageReference Include="NPOI" Version="2.7.1" />
    <PackageReference Include="Qdrant.Client" Version="1.10.0" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="StackExchange.Redis" Version="2.9.25" />
  </ItemGroup>

  <ItemGroup>
    <!-- 开发期 ProjectReference，dotnet pack 自动转成对应版本的包依赖 -->
    <ProjectReference Include="..\SB.Framework.Core\SB.Framework.Core.csproj" />
    <ProjectReference Include="..\SB.Framework.Models\SB.Framework.Models.csproj" />
    <!-- 分析器不随 Core 的 ProjectReference 传递(analyzer 项不流动),必须直接引用 -->
    <ProjectReference Include="..\SB.Framework.Analyzers\SB.Framework.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- 让 WebApi 程序集能跨 assembly 访问 Services 里 internal 匿名类型(controller 里 dynamic
         访问 service 返回的匿名对象成员,如 AppSettings Save restart=true 路径)。
         不加这条 → RuntimeBinderException: 'object' does not contain a definition for '...' -->
    <InternalsVisibleTo Include="SB.Framework.WebApi" />
  </ItemGroup>

</Project>
