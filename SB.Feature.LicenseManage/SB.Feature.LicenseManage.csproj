<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SB.Feature.LicenseManage</RootNamespace>
    <AssemblyName>SB.Feature.LicenseManage</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>SB.Feature.LicenseManage</PackageId>
    <Version>0.1.0</Version>
    <Description>SB Feature 授权管理（签发端：管理客户/审批/签发/吊销）</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core: DomainExpander / LicensePayload / IFeatureModule。Models: 4实体 + DTO + 枚举 + IModuleInitializer。
         开发期 ProjectReference（发布期 dotnet pack 自动转包依赖，变体由发包参数收敛）。 -->
    <ProjectReference Include="..\SB.Framework.Core\SB.Framework.Core.csproj" />
    <ProjectReference Include="..\SB.Framework.Models\SB.Framework.Models.csproj" />
    <!-- EntitlementController / VerifyController 需要 MVC 类型 -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <!-- LicenseManage 不依赖 BaseCrudService —— LicenseManageService 直接用 IFreeSql.Select<>，不继承基类。
       两个样板恰好覆盖"要基类(BackupReceive) / 不要基类(LicenseManage)"两种。 -->
</Project>
