<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SB.FlowEngine</RootNamespace>
    <AssemblyName>SB.FlowEngine</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Version>0.2.2</Version>
    <Description>SB 图执行引擎(前端 @saibo/flow-engine 的服务端对称实现):读 FlowGraph 执行,内置 if/loop/goto/label/变量/wait/subFlow 控制节点,业务节点经 IFlowNodeExecutor 接入,支持节点级 retry/stopOnError/delay 执行机制</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- 开发期走 ProjectReference,dotnet pack 自动转成 SB.Framework.Core 包依赖 -->
    <ProjectReference Include="..\SB.Framework.Core\SB.Framework.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SB.Framework.Analyzers\SB.Framework.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
