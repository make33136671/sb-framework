{
  "TimeZone": "Asia/Shanghai",
  "EncryptionKey": "SB2024DefaultKey!",
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "RollingFile",
              "Args": {
                "pathFormat": "logs/error-{Date}.ndjson",
                "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
                "restrictedToMinimumLevel": "Error"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "RollingFile",
              "Args": {
                "pathFormat": "logs/info-{Date}.ndjson",
                "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
                "restrictedToMinimumLevel": "Information",
                "restrictedToMaximumLevel": "Information"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "RollingFile",
              "Args": {
                "pathFormat": "logs/warning-{Date}.ndjson",
                "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
                "restrictedToMinimumLevel": "Warning",
                "restrictedToMaximumLevel": "Warning"
              }
            }
          ]
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "ProductCn": "测试管理系统",
  "ProductEn": "test",
  "Debug": true,
  "DbConfig": {
    "DbType": "MySql",
    "Server": "192.168.10.100",
    "Port": "3306",
    "Database": "Test",
    "User": "root",
    "Password": "111111",
    "AutoSyncStructure": false,
    "MonitorSqlCommandForLog": false,
    "SlowQueryThresholdMs": 200
  },
  "CacheConfig": {
    "Enabled": true,
    "Provider": "Redis",
    "Redis": {
      "Connection": "192.168.10.100:6379",
      "InstanceName": "test:"
    }
  },
  "PasswordConfig": {
    "StorageMode": "PlainText"
  },
  "UploadConfig": {
    "MaxFileSizeMB": 2048,
    "ChunkThresholdMB": 10,
    "ChunkSizeMB": 1,
    "MaxConcurrent": 4,
    "UploadPath": "/storage/uploads/",
    "ChunkTempPath": "/storage/chunks/",
    "ChunkExpireHours": 24,
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".gif",
      ".bmp",
      ".webp",
      ".svg",
      ".mp4",
      ".webm",
      ".mov",
      ".pdf",
      ".doc",
      ".docx",
      ".xls",
      ".xlsx",
      ".zip",
      ".rar",
      ".7z"
    ],
    "DebugThrottleMs": 0
  },
  "RateLimitConfig": {
    "WindowSeconds": 60,
    "PermitLimit": 10
  },
  "CorsConfig": {
    "AllowAll": true,
    "Origins": []
  },
  "JwtAdmin": {
    "Key": "XfaVfOX7L2DWM4dLGTdrmiaVmcxhFGc9GDramm/FZYw=",
    "Issuer": "testAdminAPI",
    "Audience": "testAdmin",
    "Expires": "1440"
  },
  "JwtApi": {
    "Key": "FwX0D8BSofJtkAYMjQgtUOLzMfjiOgnkYOxNPssW9zM=",
    "Issuer": "testAPI",
    "Audience": "testAPI",
    "Expires": "10080"
  },
  "DeployConfig": {
    "Projects": [
      {
        "Name": "admin",
        "Key": "admin",
        "Path": "/www/wwwroot/test_admin"
      },
      {
        "Name": "h5",
        "Key": "h5",
        "Path": "/www/wwwroot/test_h5"
      }
    ]
  },
  "ProjectAssemblyName": null,
  "ExcludeControllers": [],
  "PrimaryDomain": "test.com",
  "LicenseConfig": {
    "Key": ""
  },
  "CloudConfig": {
    "ServerUrl": ""
  }
}